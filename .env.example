# Copy to .env and fill locally. Never commit .env.
ALIYUN_API_KEY=REPLACE_ME
DEEPSEEK_API_KEY=REPLACE_ME
SILICONFLOW_API_KEY=REPLACE_ME

# Optional local paths. Set these for the machine where experiments run.
CALIPER_ROOT=.
CALIPER_DATA_ROOT=./data
CALIPER_MODEL_ROOT=./models
CALIPER_RESULTS_ROOT=./results
CALIPER_EMBED_MODEL=BAAI/bge-base-en-v1.5
CALIPER_RERANK_MODEL=BAAI/bge-reranker-large
CALIPER_FT_MODEL_ROOT=./retrieve_fine_tuning/models
CALIPER_METRIC_MODEL=./models/paraphrase-mpnet-base-v2
CALIPER_CLASSIFIER_PATH=./query_clf/train_new/9b_clf.bin

# Optional OpenAI-compatible local service endpoints.
CALIPER_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
CALIPER_LOCAL_API_KEY=vllm
CALIPER_LOCAL_MODEL_NAME=Qwen3.5-9B
CALIPER_CLOUD_BASE_URL=
