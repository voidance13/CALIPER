@article{guo2025leveraging,
title = {Leveraging inter-chunk interactions for enhanced retrieval in large language model-based question answering},
journal = {Neurocomputing},
volume = {650},
pages = {130931},
year = {2025},
issn = {0925-2312},
doi = {10.1016/j.neucom.2025.130931},
author = {Tiezheng Guo and Chen Wang and Yanyi Liu and Jiawei Tang and Pan Li and Sai Xu and Qingwen Yang and Xianlin Gao and Zhi Li and Yingyou Wen},
keywords = {Multi-document question answering, Retrieval augmented generation, Inter-chunk interactions, Evidence chain, Large language model},
abstract = {Retrieving external knowledge and prompting large language models with relevant information is an effective paradigm to enhance the performance of question-answering tasks. However, in multi-document question answering tasks, existing studies often evaluate the relevance of each paragraph to the question independently. This approach can lead to issues such as missing context and ambiguous references in the knowledge retrieved, ultimately hindering the reasoning capabilities of large language models. To address this limitation, we propose a novel retrieval framework called IIER in this study, which leverages Inter-chunk Interactions to Enhance Retrieval. In IIER, we transform independent documents into a unified Chunk-Interaction Graph by constructing edges that integrate structural, keyword, and semantic information between chunks. This graph effectively completes potential reasoning paths between chunks and provides additional contextual information to guide enhanced retrieval. Additionally, we design the Evidence Chain Retriever, which iteratively searches the graph for supporting evidence by jointly encoding semantic and topological information. Through this mechanism, the retriever is able to generate prompts enriched with comprehensive context and reasoning evidence chains, thereby improving the accuracy of large language models’ reasoning. Extensive experiments conducted on multiple datasets demonstrate that IIER significantly improves retrieval performance and enhances the reasoning capabilities of large language models in MDQA tasks. Specifically, IIER outperforms strong baseline models guided by large language models, achieving accuracy improvements of 9.6 % on the 2WikiMQA and 6.0 % on the HotpotQA.}
}

@article{chen2026tgrag,
title = {Retrieving on a topic graph for long document question answering},
journal = {Neurocomputing},
volume = {669},
pages = {132447},
year = {2026},
issn = {0925-2312},
doi = {10.1016/j.neucom.2025.132447},
author = {Shiwei Chen and Bin Liang and Yue Yu and Kam-Fai Wong and Hui Wang and Ruifeng Xu},
keywords = {Long-context language modeling, Graph-based document modeling, Retrieval-augmented generation},
abstract = {Processing long-context information remains a major challenge for large language models (LLMs). Retrieval-Augmented Generation (RAG) alleviates this issue by fetching relevant passages, yet it often wastes retrieval budget on near-duplicates and disperses mutually relevant evidence across an oversizes prompt. Cognitive studies suggest that human readers instead maintain only a few topical chunks in working memory and selectively reactivate details when needed. Inspired by this principle, we propose Topic-Graph-based RAG (TGRAG) for long document question answering (LDQA). Specifically, TGRAG (1) segments a document into sentence-level units and assigns each a high-level topic label; (2) connects sentences via lightweight topic- and similarity-based edges to construct a sparse topic graph that approximates coarser topical clusters; and (3) activates the k most relevant sentences together with their strongest neighbors at query time. This graph-guided retrieval preserves cross-sectional context while reducing redundancy, thereby improving the activation of relevant information for long-term reasoning. Experiments on three LDQA benchmarks demonstrate that TGRAG outperforms competitive RAG and GraphRAG baselines, improving over the strongest baseline by 0.8, 1.0, and 2.8 absolute accuracy points on NarrativeQA, HotpotQA, and MuSiQue, respectively (averaged over strict and lenient LLM-based rating criteria), which validates its effectiveness.}
}

@article{li2025recot,
title = {RECoT: Relation-enhanced Chains-of-Thoughts for knowledge-intensive multi-hop questions answering},
journal = {Neurocomputing},
volume = {637},
pages = {129903},
year = {2025},
issn = {0925-2312},
doi = {10.1016/j.neucom.2025.129903},
author = {Ronghan Li and Dongdong Li and Haowen Yang and Xiaoxi Liu and Haoxiang Jin and RongCheng Pu and Qiguang Miao},
keywords = {Open-domain question answering, Multi-hop, CoT, Relation extraction},
abstract = {Open Domain question answering is designed to enable a computer to understand and answer any question on a wide range of topics. The prevalent retrieval-reading paradigm helps large language models (LLMs) when retrieving relevant text from external knowledge sources using questions, however the multi-hop question answering approach based on Chains-of-Thoughts (CoT) may perform poorly when it comes to complex questions. This is because there can be errors in generating sentences at each hop, and these errors accumulate, leading to significant deviations in the final result. In order to solve the above problems, this paper first extracted the relational triples of complex problems. Next, triples are used to select the most representative sentence at each step during CoT generation as the query for the next-hop retrieval. The RECoT with GPT-3 results in significant improvements with F1 score up 5.1 points in downstream QA on 2WikiMultihopQA datasets and up 2.9 points on HotpotQA datasets. In addition, improvements in results can be obtained even with smaller models such as Flan-T5-large without additional training. In conclusion, RECoT reduced model hallucination and accelerated more accurate CoT reasoning to guide retrieval to get improved results. Code is publicly available at https://github.com/XD-BDIV-NLP/RECoT.}
}

